# Copy to .env.local and fill in. Both are optional while developing:
# without them, gig requests are printed to the server console instead of emailed.

# API key from https://resend.com (free tier is plenty)
RESEND_API_KEY=

# Where gig requests should go, e.g. the business manager's inbox
GIG_REQUEST_TO=

# Optional sender. Leave blank to use Resend's test sender, which can ONLY
# deliver to the email you signed up to Resend with. Once you verify a domain
# in Resend, set e.g.: Gig Requests <gigs@yourgroup.com>
GIG_REQUEST_FROM=
