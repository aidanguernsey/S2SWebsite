# Copy to .env.local and fill in. All are optional while developing.

# --- Content (Sanity) ---
# Without a project ID the site shows the starter data in content/. See README → "Editing content".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Any long random string; paste the same value into the Sanity webhook's Secret field.
SANITY_REVALIDATE_SECRET=

# Only needed to run `npm run seed` once. Editor token from sanity.io/manage → API → Tokens.
# Keep it in .env.local only; don't add it to Vercel.
SANITY_API_WRITE_TOKEN=

# --- Gig requests ---
# Without these, gig requests are printed to the server console instead of emailed.

# API key from https://resend.com (free tier is plenty)
RESEND_API_KEY=re_your_api_key_here

# Where gig requests should go, e.g. the business manager's inbox
GIG_REQUEST_TO=you@example.com

# Optional sender. Leave blank to use Resend's test sender, which can ONLY
# deliver to the email you signed up to Resend with. Once you verify a domain
# in Resend, set e.g.: Gig Requests <gigs@yourgroup.com>
GIG_REQUEST_FROM=

# Optional Google Sheet log of every request. Web app URL (ends in /exec)
# from deploying scripts/gig-sheet.gs; see README.
GIG_SHEET_URL=
